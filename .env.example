# Porta HTTP da API
PORT=3000

# Ambiente: development | production | test
NODE_ENV=development

# Banco de dados (SQLite). O caminho é relativo à pasta prisma/
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os tokens JWT (troque em produção: mínimo 32 caracteres aleatórios)
JWT_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio"

# Validade do token de acesso, em segundos (3600 = 1 hora)
JWT_EXPIRES_IN=3600

# Origens permitidas no CORS (separadas por vírgula). Use * apenas em desenvolvimento.
CORS_ORIGINS=*

# Nível de log: debug | info | warn | error | silent
LOG_LEVEL=info

# Gateway de pagamento simulado (mock): latência simulada (ms), timeout e novas tentativas
PAYMENT_MOCK_LATENCY_MS=150
PAYMENT_TIMEOUT_MS=2000
PAYMENT_MAX_RETRIES=2
