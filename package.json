{
  "name": "raizes-do-nordeste-api",
  "version": "1.0.0",
  "description": "API Back-end da rede de lanchonetes Raízes do Nordeste (pedidos multicanal, estoque por unidade, pagamento mock, fidelização e LGPD).",
  "main": "src/server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "setup": "prisma migrate deploy && prisma db seed",
    "test": "node scripts/prepare-test-db.js && node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:postman": "node scripts/run-postman.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "api",
    "rest",
    "express",
    "prisma",
    "lgpd"
  ],
  "author": "Dylines Guanipa",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "newman": "^6.2.3",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1"
  }
}
